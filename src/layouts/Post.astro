---
import Base from './Base.astro';
import MetaCell from '../components/MetaCell.astro';
import Subscribe from '../components/Subscribe.astro';
import { AUTHOR } from '../consts';
import { getPosts, isoDate, postNumber, readingTime, slugifyTag, url, type Post } from '../lib';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, subtitle, date, updated, tags } = post.data;
const all = await getPosts();
const i = all.findIndex((p) => p.id === post.id);
const newer = all[i - 1];
const older = all[i + 1];
---

<Base title={title} description={subtitle}>
  <header class="grid3">
    <div class="cell span2" style="display:flex;flex-direction:column;justify-content:flex-end;gap:12px">
      <span class="label">No. {postNumber(post, all)}</span>
      <h1 class="cond" style="font-size:clamp(50px,6.5vw,96px);line-height:.9;margin:0;text-wrap:balance">{title}</h1>
      {subtitle && <p style="margin:0;font-size:27px;max-width:40ch">{subtitle}</p>}
    </div>
    <MetaCell date={date}>
      <div>
        <div>BY {AUTHOR.toUpperCase()}</div>
        <div><time datetime={date.toISOString()}>{isoDate(date)}</time> · {readingTime(post.body)}</div>
        {updated && <div>UPDATED {isoDate(updated)}</div>}
        {tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => <a href={url(`tags/${slugifyTag(tag)}/`)}>#{tag}</a>)}
          </div>
        )}
      </div>
    </MetaCell>
  </header>

  <article class="prose">
    <slot />
  </article>

  <section class="cell band">
    <b class="cond">Get the next one</b>
    <Subscribe button="Join" />
  </section>

  {(older || newer) && (
    <nav class="grid3" aria-label="More posts">
      {older ? (
        <a class="cell post-cell" href={url(`posts/${older.id}/`)}>
          <span class="label">← Previous</span>
          <h2>{older.data.title}</h2>
        </a>
      ) : <div class="cell" />}
      <a class="cell post-cell" href={url('archive/')}>
        <span class="label">All posts</span>
        <h2>Archive</h2>
      </a>
      {newer ? (
        <a class="cell post-cell" href={url(`posts/${newer.id}/`)}>
          <span class="label">Next →</span>
          <h2>{newer.data.title}</h2>
        </a>
      ) : <div class="cell" />}
    </nav>
  )}
</Base>
