---
import Base from './Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { AUTHOR } from '../consts';
import { formatDate, readingTime, slugifyTag, url, type Post } from '../lib';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, subtitle, date, updated, tags } = post.data;
---

<Base title={title} description={subtitle}>
  <article class="container">
    <header>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <div class="byline">
        <div class="avatar" aria-hidden="true">{AUTHOR.charAt(0)}</div>
        <div>
          <div class="author">{AUTHOR}</div>
          <div class="meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)}
            {updated && <> · updated {formatDate(updated)}</>}
          </div>
        </div>
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>#{tag}</a>)}
      </div>
    )}

    <Subscribe />
  </article>
</Base>

<style>
  header { padding: 48px 0 24px; border-bottom: 1px solid var(--border); margin-bottom: 32px; }
  h1 { font-size: 40px; line-height: 1.15; margin: 0 0 12px; letter-spacing: -0.01em; }
  .subtitle { font-family: var(--serif); font-size: 22px; color: var(--muted); margin: 0 0 24px; line-height: 1.4; }
  .byline { display: flex; align-items: center; gap: 12px; }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-text);
    display: grid;
    place-items: center;
    font-weight: 700;
    flex-shrink: 0;
  }
  .author { font-weight: 600; font-size: 15px; }
  .tags { margin-top: 32px; }
  @media (max-width: 480px) {
    h1 { font-size: 32px; }
    .subtitle { font-size: 19px; }
  }
</style>
