---
import '../styles/global.css';
import { AUTHOR, GITHUB_URL, LINKTREE_URL, SITE_TITLE, SITE_TAGLINE } from '../consts';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_TAGLINE } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400;62..125,700;62..125,900&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body>
    <div class="poster">
      <aside class="spine">
        <a class="cond" href={url('/')} aria-label={`${SITE_TITLE} home`}>{SITE_TITLE}</a>
      </aside>
      <div class="sheet">
        <slot />
        <footer class="cell foot">
          <span>© {year} {AUTHOR}</span>
          <span>
            <a href={url('rss.xml')}>RSS</a> · <a href={GITHUB_URL}>GitHub</a> · <a href={LINKTREE_URL}>Links</a>
          </span>
        </footer>
      </div>
    </div>
  </body>
</html>
