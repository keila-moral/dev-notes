---
import type { Post } from '../lib';
import { formatDate, readingTime, url } from '../lib';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article>
  <a href={url(`posts/${post.id}/`)}>
    <h2>{post.data.title}{post.data.draft && <span class="draft">draft</span>}</h2>
    {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
  </a>
  <p class="meta">{formatDate(post.data.date)} · {readingTime(post.body)}</p>
</article>

<style>
  article { padding: 24px 0; border-bottom: 1px solid var(--border); }
  a { text-decoration: none; }
  a:hover h2 { color: var(--accent); }
  h2 { margin: 0 0 4px; font-size: 22px; line-height: 1.3; }
  .subtitle { margin: 0 0 8px; color: var(--muted); font-family: var(--serif); font-size: 18px; }
  .meta { margin: 0; }
  .draft {
    font-size: 12px;
    vertical-align: middle;
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-text);
  }
</style>
