---
import { SITE_TITLE } from '../consts';
import { url } from '../lib';
---

<header>
  <div class="container bar">
    <a class="brand" href={url('/')}>{SITE_TITLE}</a>
    <nav>
      <a href={url('archive/')}>Archive</a>
      <a href={url('about/')}>About</a>
      <a class="btn small" href={url('#subscribe')}>Subscribe</a>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
    max-width: 1000px;
  }
  .brand {
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  nav { display: flex; align-items: center; gap: 18px; font-size: 15px; }
  nav a:not(.btn) { text-decoration: none; color: var(--muted); }
  nav a:not(.btn):hover { color: var(--text); }
  .small { padding: 6px 14px; font-size: 14px; }
  @media (max-width: 480px) {
    nav a:not(.btn) { display: none; }
  }
</style>
