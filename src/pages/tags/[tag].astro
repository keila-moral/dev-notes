---
import Base from '../../layouts/Base.astro';
import MetaCell from '../../components/MetaCell.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getPosts, pad, slugifyTag } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugifyTag(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)), all: posts },
  }));
}

const { tag, posts, all } = Astro.props;
---

<Base title={`#${tag}`}>
  <section class="grid3">
    <div class="cell big span2">
      <span class="num cond">{pad(posts.length)}</span>
      <h1 class="cond" style="font-size:clamp(36px,5vw,64px)">#{tag}</h1>
    </div>
    <MetaCell date={posts[0]?.data.date} />
  </section>
  <PostGrid posts={posts} all={all} />
</Base>
