---
import Base from '../layouts/Base.astro';
import MetaCell from '../components/MetaCell.astro';
import { url } from '../lib';
---

<Base title="Not found">
  <section class="grid3">
    <div class="cell big span2">
      <span class="num cond">404</span>
      <p>That page doesn't exist. <a href={url('/')}>Back to the front page →</a></p>
    </div>
    <MetaCell />
  </section>
</Base>
