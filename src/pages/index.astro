---
import Base from '../layouts/Base.astro';
import MetaCell from '../components/MetaCell.astro';
import PostGrid from '../components/PostGrid.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE_TAGLINE } from '../consts';
import { getPosts, pad } from '../lib';

const posts = await getPosts();
---

<Base>
  <section class="grid3">
    <div class="cell big span2">
      <span class="num cond">{pad(posts.length)}</span>
      <p>{SITE_TAGLINE} <b>{posts.length} {posts.length === 1 ? 'post' : 'posts'} so far.</b></p>
    </div>
    <MetaCell date={posts[0]?.data.date}>
      <Subscribe />
    </MetaCell>
  </section>
  {posts.length > 0 ? <PostGrid posts={posts} all={posts} /> : <p class="cell">No posts yet.</p>}
</Base>
