---
import Base from '../layouts/Base.astro';
import MetaCell from '../components/MetaCell.astro';
import { getPosts, isoDate, postNumber, readingTime, slugifyTag, url } from '../lib';

const posts = await getPosts();
const years = Map.groupBy(posts, (post) => post.data.date.getFullYear());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Base title="Archive">
  <section class="grid3">
    <div class="cell big span2"><h1 class="cond">Archive</h1></div>
    <MetaCell date={posts[0]?.data.date}>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <a href={url(`tags/${slugifyTag(tag)}/`)}>#{tag}</a>)}
        </div>
      )}
    </MetaCell>
  </section>
  <div class="row head" aria-hidden="true"><span>No.</span><span>Title</span><span>Date</span><span>Length</span></div>
  {[...years].map(([year, items]) => (
    <section>
      <h2 class="year cond">{year}</h2>
      {items.map((post) => (
        <a class="row" href={url(`posts/${post.id}/`)}>
          <span class="n cond">{postNumber(post, posts)}</span>
          <div>
            <h2>{post.data.title}</h2>
            {post.data.subtitle && <p>{post.data.subtitle}</p>}
          </div>
          <span class="d">{isoDate(post.data.date)}</span>
          <span class="d">{readingTime(post.body).replace(' read', '')}</span>
        </a>
      ))}
    </section>
  ))}
</Base>
