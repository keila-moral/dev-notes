---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, slugifyTag, url } from '../lib';

const posts = await getPosts();
const years = Map.groupBy(posts, (post) => post.data.date.getFullYear());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Base title="Archive">
  <div class="container">
    <h1>Archive</h1>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>#{tag}</a>)}
      </div>
    )}
    {[...years].map(([year, items]) => (
      <section>
        <h2 class="section-title">{year}</h2>
        <ul>
          {items.map((post) => (
            <li>
              <a href={url(`posts/${post.id}/`)}>{post.data.title}</a>
              <span class="meta">{formatDate(post.data.date)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  h1 { margin: 48px 0 16px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border); }
  li a { text-decoration: none; font-weight: 600; }
  li .meta { white-space: nowrap; }
</style>
